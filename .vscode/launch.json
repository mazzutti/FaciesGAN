{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Launch FaciesGAN (debugpy)",
      "type": "debugpy",
      "request": "launch",
      "module": "torch.distributed.run",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "subProcess": true,
      "redirectOutput": true,
      "preLaunchTask": "kill-torchrun-orphans",
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}/.venv/lib/python3.13/site-packages:${workspaceFolder}/build/_deps/mlx-src/python:${workspaceFolder}/mlx-c/python",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1"
      },
      "args": [
        "--nproc_per_node=2",
        "main.py",
        "--input-path",
        "data",
        "--output-path",
        "results/py/",
        "--num-train-pyramids",
        "200",
        "--batch-size",
        "40",
        "--num-workers",
        "2",
        "--num-iter",
        "1000",
        "--num-parallel-scales",
        "7",
        "--discriminator-steps",
        "3",
        "--generator-steps",
        "3",
        "--reconstruction-loss-penalty",
        "10",
        "--scale0-noise-amp",
        "1.5",
        "--min-noise-amp",
        "0.3",
        "--use-wells",
        "--use-seismic",
        // "--use-mlx",
        "--compile-backend",
        "--no-tensorboard"
      ]
    },
    {
      "name": "Python: Attach FaciesGAN (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ],
      "justMyCode": false
    },
    {
      "name": "C: Launch FaciesGAN (lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/faciesgan",
      "preLaunchTask": "Build FaciesGAN (Release+LTO)",
      "miDebuggerPath": "/usr/bin/lldb",
      "MIMode": "lldb",
      "args": [
        "--input-path",
        "data",
        "--output-path",
        "results/c/",
        "--num-train-pyramids",
        "1",
        "--batch-size",
        "1",
        "--num-workers",
        "0",
        "--num-iter",
        "100",
        "--num-parallel-scales",
        "7",
        "--discriminator-steps",
        "3",
        "--generator-steps",
        "3",
        "--alpha",
        "10",
        "--scale0-noise-amp",
        "1.5",
        "--min-noise-amp",
        "0.3",
        "--use-wells",
        "--use-seismic",
        // "--use-mlx"
        "--compile-backend"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "OUTPUT_PATH",
          "value": "${workspaceFolder}/results/"
        },
        {
          "name": "PYTHONPATH",
          "value": "${workspaceFolder}/.venv/lib/python3.13/site-packages:${workspaceFolder}/build/_deps/mlx-src/python:${workspaceFolder}/mlx-c/python"
        },
        {
          "name": "PYTHONEXECUTABLE",
          "value": "${workspaceFolder}/.venv/bin/python"
        },
        {
          "name": "VIRTUAL_ENV",
          "value": "${workspaceFolder}/.venv"
        },
        {
          "name": "PATH",
          "value": "${workspaceFolder}/.venv/bin:${env:PATH}"
        },
        {
          "name": "FACIESGAN_COLLATE_VECTORIZE",
          "value": "1"
        },
        {
          "name": "FACIESGAN_IPC_SHM",
          "value": "1"
        },
        {
          "name": "FACIESGAN_HUGEPAGE",
          "value": "1"
        },
        {
          "name": "FACIESGAN_PIN_WORKER",
          "value": "1"
        },
        {
          "name": "FACIESGAN_RT_SCHED",
          "value": "1"
        },
        {
          "name": "FACIESGAN_RT_PRIORITY",
          "value": "10"
        },
        {
          "name": "FACIESGAN_BORROW_BATCHES",
          "value": "1"
        },
        {
          "name": "FACIESGAN_ALLOW_DATALOADER_WORKERS",
          "value": "1"
        },
        {
          "name": "FACIESGAN_ALLOW_PARALLEL_SCALES",
          "value": "7"
        },
        {
          "name": "FACIESGAN_PROCESS_WORKERS",
          "value": "1"
        },
        {
          "name": "FACIESGAN_PROC_SYNC_IO",
          "value": "1"
        },
        {
          "name": "FACIESGAN_USE_WELLS",
          "value": "1"
        },
        {
          "name": "FACIESGAN_USE_SEISMIC",
          "value": "1"
        }
      ],
      "stopAtEntry": false,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Set max children count",
          "text": "settings set target.max-children-count 256",
          "ignoreFailures": true
        },
        {
          "description": "Set max string summary length",
          "text": "settings set target.max-string-summary-length 512",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Python: Generate Facies",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/gen_facies.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/.venv/lib/python3.13/site-packages:${workspaceFolder}/build/_deps/mlx-src/python:${workspaceFolder}/mlx-c/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      },
      "args": [
        "--how_many",
        "${input:howMany}",
        "--model_path",
        "${workspaceFolder}/results/py/2026_03_07_22_16_43",
        "--out_path",
        "${workspaceFolder}/results/py/generated",
        "--use_gpu",
        "--plot_well_mask"
      ]
    },
    {
      "name": "Python: Train Neural Smoothers",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/train_neural_smoothers.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/.venv/lib/python3.13/site-packages:${workspaceFolder}/build/_deps/mlx-src/python:${workspaceFolder}/mlx-c/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      },
      "args": [
        "--facies",
        "--impedance",
        "--epochs",
        "2000",
        "--lr",
        "3e-4"
        // "--force"
      ]
    },
    {
      "name": "Python: Experiments (Ablation)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "preLaunchTask": "start-tensorboard",
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}/.venv/lib/python3.13/site-packages:${workspaceFolder}/build/_deps/mlx-src/python:${workspaceFolder}/mlx-c/python",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1"
      },
      "args": [
        "--use-impedance",
        // "--no-shuffle",
        "--input-path", "data",
        "--output-path", "results/experiments",
        "--no-embeddings",
        "--how-many", "0",
        "--num-iter", "100",
        "--start-epoch", "10000",
        "--num-train-pyramids", "200",
        "--batch-size", "2",
        "--num-workers", "2",
        "--num-parallel-scales", "7",
        "--nproc-per-node", "2",
        "--lr-d", "1e-4",
        "--lr-g", "5e-4",
        // "--lr-g-factor", "0.5",
        "--lr-patience", "99999",
        // "--lr-decay-unit", "batch",
        // "--lr-min", "1e-5",
        "--discriminator-steps", "2",
        "--scale0-disc-steps-multiplier", "2",
        "--scale0-loss-multiplier", "2.0",
        "--scale0-noise-amp", "1.5",
        "--generator-steps", "4",
        "--well-loss-penalty", "1.0",
        "--reconstruction-loss-penalty", "1.0",
        "--gradient-loss-penalty", "1.0",
        "--diversity-loss-penalty", "0.3",
        "--adversarial-loss-penalty", "1.0",
        "--impedance-loss-penalty", "1.0",
        "--grad-clip-norm", "1.0",
        "--num-diversity-samples", "3",
        "--gp-interval", "2",
        "--min-noise-amp", "0.3",
      ]
    },
    {
      "name": "Python: Experiments (Generate + Comparisons)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}/.venv/lib/python3.13/site-packages:${workspaceFolder}/build/_deps/mlx-src/python:${workspaceFolder}/mlx-c/python",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1"
      },
      "args": [
        "--skip-training",
        "--model-paths",
        "results/experiments/wells_seismic",
        "results/experiments/wells_only",
        "results/experiments/seismic_only",
        "results/experiments/unconditional",
        "--use-impedance",
        "--input-path", "data",
        "--output-path", "results/experiments",
        "--embedding-methods", "isomap", "mds", "tsne", "umap",
        "--embedding-data", "facies", "impedance", "seismic",
        "--embedding-data", "seismic",
        "--embedding-per-class",
        "--num-iter", "100",
        "--nproc-per-node", "2",
        "--how-many", "1000",
        "--no-tensorboard",
      ]
    }
  ],
  "inputs": [
    {
      "id": "howMany",
      "type": "promptString",
      "description": "How many facies to generate?",
      "default": "10"
    }
  ],
  "compounds": [
    {
      "name": "Parallel: Python + C (with dumps)",
      "preLaunchTask": "prepare-parallel-dumps",
      "configurations": [
        "Python: Launch FaciesGAN (debugpy)",
        "C: Launch FaciesGAN (lldb)"
      ]
    }
  ]
}
